{
  "name": "gganbu-app-bridge",
  "private": true,
  "version": "0.5.1",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Game-Buddy/GGanbu-App-Bridge.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "tauri": "node scripts/tauri.mjs",
    "version:set": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs",
    "msix:check": "node scripts/msix.mjs check",
    "msix:prepare": "node scripts/msix.mjs prepare",
    "license:check": "node scripts/license-check.mjs && node scripts/generate-third-party-notices.mjs --check",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --all-features",
    "check": "pnpm version:check && pnpm msix:check && pnpm license:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "~19.2.8",
    "react-dom": "~19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@serenity-kit/opaque": "1.1.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "~16.3.2",
    "@types/node": "~26.2.0",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@vitejs/plugin-react": "~6.0.5",
    "eslint": "~10.8.1",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "~17.11.0",
    "jsdom": "~30.0.1",
    "prettier": "~3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.67.0",
    "vite": "~8.2.1",
    "vitest": "~4.1.11"
  }
}
