{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GGanbu App Bridge",
  "version": "0.5.5",
  "identifier": "com.gamebuddy.gganbu-app-bridge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "GGanbu App Bridge",
        "width": 960,
        "height": 540,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Game Buddy",
    "homepage": "https://github.com/Game-Buddy/GGanbu-App-Bridge",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "assets/config/hotkeys/*",
      "../LICENSE",
      "../THIRD_PARTY_NOTICES.md"
    ]
  }
}
